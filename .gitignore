# Common ignores
node_modules
.next/
# Any alternate build output (NEXT_DIST_DIR in next.config.mjs). Tailwind scans
# every non-ignored file for class candidates, and Turbopack's binary cache inside
# a build directory yields garbage ones that break the CSS build.
.next-*/
.test-dist/
*.tsbuildinfo
.DS_Store
