GROQ_API_KEY=
# Optional server-only pool. When present, guide requests rotate across unique
# keys. GROQ_API_KEY remains the backward-compatible fallback.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional authorised travel-inventory providers. Keep every value server-only.
# Amadeus Self-Service is the recommended first connection for date-matched
# flight offers. Booking and Skyscanner require approved partner access.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=
SKYSCANNER_API_KEY=

# Optional Uber partner integration. Use only scopes approved for this app.
# Sandbox credentials do not provide real-world ride prices.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_OAUTH_SCOPE=
UBER_OAUTH_BASE_URL=https://sandbox-login.uber.com

WEATHER_API_KEY=
NEXT_PUBLIC_SITE_URL=
